# CONFIGURAÇÕES DO SISTEMA DE FOLLOW-UP - CCVIDEIRA CAPIM MACIO
# Copie este arquivo como '.env' e ajuste os valores para o seu ambiente.

# --- BANCO DE DADOS ---
# String de conexão PostgreSQL usada pelo Prisma (ver prisma/schema.prisma)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/followup?schema=public"

# --- SESSÃO ---
# Segredo usado para assinar (HMAC) o cookie de sessão.
# Obrigatório em produção — o app falha ao subir se estiver ausente.
# Gere um valor aleatório forte, por exemplo: openssl rand -hex 32
SESSION_SECRET=troque_por_um_valor_aleatorio_forte

# --- ENVIO DE E-MAIL (código de acesso) ---
# Se EMAIL_SERVER_HOST não estiver definido, o app roda em modo dev e
# apenas imprime o código de acesso no console em vez de enviar e-mail.
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=seu_usuario_smtp
EMAIL_SERVER_PASSWORD=sua_senha_smtp
EMAIL_FROM=seu_email@example.com

# --- AGENTES E IA ---
# Segredo para proteger as rotas de Cron chamadas pelo GitHub Actions
AGENT_CRON_SECRET=um_segredo_para_proteger_o_cron

# Provedores de LLM (Cascata: Mistral -> Groq -> Gemini -> DeepSeek)
MISTRAL_API_KEY=sua_chave_mistral
GROQ_API_KEY=sua_chave_groq
GEMINI_API_KEY=sua_chave_gemini
DEEPSEEK_API_KEY=sua_chave_deepseek

# Notificações Push via Ntfy
NTFY_URL=https://ntfy.sh/
NTFY_TOPIC_AGENTS=followup_ccvideira_seu_topico_secreto