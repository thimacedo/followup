# CONFIGURAÇÕES DO SISTEMA RÁDIO IA - ESTÚDIO TJRN / NJUD
# Copie este arquivo como '.env' e ajuste os caminhos e chaves para a máquina local

# --- CHAVES DE API DO FALLBACK LLM ---
GROQ_API_KEY=sua_chave_aqui
DEEPSEEK_API_KEY=sua_chave_aqui
MISTRAL_API_KEY=sua_chave_aqui
OPENROUTER_API_KEY=sua_chave_aqui
OPENAI_API_KEY=sua_chave_aqui
GEMINI_API_KEY=sua_chave_aqui

# --- URL DO APP SCRIPT DE INTEGRAÇÃO COM PLANILHA ---
BOLETINS_WEBAPP_URL=sua_url_webapp_aqui

# --- CAMINHOS DE DRIVES E REPOSITÓRIOS ---
# Ajuste conforme a letra da unidade de disco mapeada para o Google Drive na máquina
DRIVE_ROOT=H:/Meu Drive/RADIO TJRN CONTEÚDO

# Caminho específico de controle dos Boletins (planilhas de metas)
DRIVE_BOLETINS_DIR=H:/Meu Drive/RADIO TJRN CONTEÚDO/00_PRODUCAO_2026/07_MODELOS_TUTORIAIS

# Caminho específico de saída do Giro nas Comarcas (Estrutura 5S)
DRIVE_GIRO_OUTPUT_DIR=H:/Meu Drive/RADIO TJRN CONTEÚDO/00_PRODUCAO_2026/03_GIRO_NAS_COMARCAS

# Caminhos específicos de entrada e saída do Notícias do Judiciário (NJUD - Estrutura 5S)
DRIVE_NJUD_INPUT_DIR=H:/Meu Drive/RADIO TJRN CONTEÚDO/00_PRODUCAO_2026/02_JORNAIS_NJUD/01_ROTEIROS
DRIVE_NJUD_OUTPUT_DIR=H:/Meu Drive/RADIO TJRN CONTEÚDO/00_PRODUCAO_2026/02_JORNAIS_NJUD/03_AUDIOS_RADIO
VOICE_AGENT_URL=http://127.0.0.1:8002

# --- DRIVE WATCHER (O1): IDs das pastas monitoradas reativamente ---
# Execute: drive_service.files().get(fileId=\"ID_DA_PASTA\", fields=\"id,name\").execute()
NJUD_ROTEIROS_FOLDER_ID=
GIRO_ROTEIROS_FOLDER_ID=

# --- DOC CACHE (O2): Configuração do cache local de documentos ---
# TTL padrão em segundos (3600 = 1 hora)
DOC_CACHE_TTL_S=3600

# --- CREDENCIAIS DA CONTA DE SERVIÇO ---
CREDENTIALS_PATH=config/credentials/service_account.json

# --- EMAIL DE RELATÓRIO DIÁRIO ---
EMAIL_RECIPIENT=seu_email@gmail.com

# --- CONFIGURAÇÃO DE EMAIL PARA ENVIO DE CÓDIGO DE ACESSO ---
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=seu_usuario_smtp
EMAIL_SERVER_PASSWORD=sua_senha_smtp
EMAIL_FROM=seu_email@example.com